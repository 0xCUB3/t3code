@@ -0,0 +1,68 @@
+package com.swmansion.enriched.markdown.utils.text.view
+
+import android.text.Spanned
+import android.view.MotionEvent
+import android.view.ViewConfiguration
+import android.widget.TextView
+import com.swmansion.enriched.markdown.spans.ScrollableMathSpan
+import kotlin.math.abs
+
+/** Scroll a wide native formula without handing horizontal drags to text selection. */
+class InlineMathTouch(private val view: TextView) {
+  private var active: ScrollableMathSpan? = null
+  private var startX = 0f
+  private var startY = 0f
+  private var startOffset = 0f
+  private var dragging = false
+
+  fun onTouchEvent(event: MotionEvent): Boolean {
+    when (event.actionMasked) {
+      MotionEvent.ACTION_DOWN -> {
+        active = null
+        dragging = false
+        val layout = view.layout ?: return false
+        val text = view.text as? Spanned ?: return false
+        val x = event.x - view.totalPaddingLeft + view.scrollX
+        val y = event.y - view.totalPaddingTop + view.scrollY
+        val line = layout.getLineForVertical(y.toInt())
+        if (y < layout.getLineTop(line) || y > layout.getLineBottom(line)) return false
+        // getOffsetForHorizontal chooses the nearest insertion point, which can
+        // be the character AFTER a wide replacement span. Inspect the whole line.
+        active = text.getSpans(layout.getLineStart(line), layout.getLineEnd(line), ScrollableMathSpan::class.java)
+          .firstOrNull { span ->
+            val start = text.getSpanStart(span)
+            val end = text.getSpanEnd(span)
+            val left = minOf(layout.getPrimaryHorizontal(start), layout.getPrimaryHorizontal(end))
+            val right = maxOf(layout.getPrimaryHorizontal(start), layout.getPrimaryHorizontal(end))
+            span.maximumScrollOffset > 0 && x >= left && x <= right
+          }
+        startX = event.x
+        startY = event.y
+        startOffset = active?.scrollOffset ?: 0f
+      }
+      MotionEvent.ACTION_MOVE -> {
+        val span = active ?: return false
+        val dx = event.x - startX
+        val dy = event.y - startY
+        if (!dragging) {
+          if (abs(dy) > abs(dx)) { active = null; return false }
+          if (abs(dx) < ViewConfiguration.get(view.context).scaledTouchSlop) return false
+          if (startOffset <= 0 && dx > 0) { active = null; return false }
+          dragging = true
+        }
+        view.parent?.requestDisallowInterceptTouchEvent(true)
+        span.scrollOffset = (startOffset - dx).coerceIn(0f, span.maximumScrollOffset)
+        view.invalidate()
+        return true
+      }
+      MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+        val consumed = dragging
+        active = null
+        dragging = false
+        view.parent?.requestDisallowInterceptTouchEvent(false)
+        return consumed
+      }
+    }
+    return false
+  }
+}
