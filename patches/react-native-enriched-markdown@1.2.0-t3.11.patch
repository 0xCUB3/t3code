+package com.swmansion.enriched.markdown.spans
+
+/** Native text measurement and touch handling share this optional math contract. */
+interface WidthAwareMathSpan {
+  fun setAvailableWidth(width: Int): Boolean
+  fun naturalWidth(): Int
+}
+
+interface ScrollableMathSpan : WidthAwareMathSpan {
+  val latexSource: String
+  val maximumScrollOffset: Float
+  var scrollOffset: Float
+}
